  "interpretation": {
    "timestamps": "preserve original values; parse timezone with explicit import profile when absent",
    "json_text_columns": [
      "seen_dates",
      "points_json",
      "quotes_json"
    ],
    "growth_statuses": "preserve raw values; pending/sending/sent/rejected/ambiguous are classified during import; unknown values quarantined",
    "fingerprints": "preserve as imported metadata, do not recompute to silently replace identity",
    "active_claims": "do not migrate a live sending lease into automatic resend"
  },
  "other_inputs": {
    "seen": "UTF-8 complete lines platform/content or chat:message keys; retain holes and overflow",
    "markers": "retain bytes; content may be plain text or JSON depending on artifact/version",
    "ledgers": "04-integrations.md#ledgers",
    "derived_indexes": "preserve raw snapshots and generation metadata; rebuild rather than requiring legacy physical schema",
    "intent_feedback": "preserve raw intent-feedback.v1 and intent-feedback.topic-reclassification.v1 events; import stable event IDs and idempotency keys without rewriting events"
  }
